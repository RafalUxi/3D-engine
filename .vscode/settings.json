{
  // Formatting
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // IntelliSense: suggestions for names, signatures and docs (e.g. Math.atan2, dot(a, b))...
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.parameterHints.enabled": true,
  "editor.hover.enabled": "on",

  // ...but no ghost-text completions of whole lines (AI / inline suggestions).
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": { "*": false },
  "github.copilot.nextEditSuggestions.enabled": false,

  // Inlay hints: grey, read-only labels with inferred types (not inserted into the file)
  "editor.inlayHints.enabled": "on",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.variableTypes.suppressWhenTypeMatchesName": true,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,

  // Tailwind IntelliSense for classes in HTML/TS
  "files.associations": { "*.css": "tailwindcss" }
}
